<Project Sdk="WixToolset.Sdk/5.0.2">

  <!-- Neutrale Vorlage der Agent-MSI. Server-Adresse und Zertifikat trägt erst der DNWsus-Server beim Download ein. -->
  <PropertyGroup>
    <OutputName>DnwSus-Agent</OutputName>
    <Platform>x64</Platform>
    <Version Condition="'$(Version)' == ''">2.0.0</Version>
    <AgentDir Condition="'$(AgentDir)' == ''">..\..\src\DnwSus.Agent\bin\Release\net48</AgentDir>
    <HinweisDir Condition="'$(HinweisDir)' == ''">..\..\src\DnwSus.Hinweis\bin\Release\net48</HinweisDir>
    <DefineConstants>Version=$(Version);AgentDir=$(AgentDir);HinweisDir=$(HinweisDir)</DefineConstants>
    <SuppressValidation>true</SuppressValidation>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
    <PackageReference Include="WixToolset.Netfx.wixext" Version="5.0.2" />
  </ItemGroup>

</Project>
