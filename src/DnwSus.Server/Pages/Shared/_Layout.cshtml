<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>DNWsus – @ViewData["Title"]</title>
    <link rel="icon" href="~/img/dnw-logo.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Ubuntu:wght@300;400;500;700&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="top">
        <a class="brand" href="/" aria-label="DNWsus, Startseite">
            <img class="brand-logo" src="~/img/dnw-logo.png" alt="Die Netz-Werker AG" />
            <span class="brand-divider"></span>
            <span class="brand-word"><span class="brand-word-accent">DNW</span>sus</span>
        </a>
        <span class="muted">Windows-Updates für Clients</span>
        <a class="navlink" href="/">Clients</a>
        <a class="navlink" href="/Agent">Agent &amp; Ereignisse</a>
        <span class="spacer"></span>
        <span class="muted">@User.Identity?.Name</span>
    </header>
    <main>
        @RenderBody()
    </main>
    <footer class="version">DNWsus @(typeof(DnwSus.Server.DnwSusOptions).Assembly.GetName().Version?.ToString(3))</footer>
    <script src="~/js/site.js" asp-append-version="true"></script>
</body>
</html>
