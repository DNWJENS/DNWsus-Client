@page
@model AgentModel
@{
    ViewData["Title"] = "Agent";
}

<h2>Agent verteilen</h2>

@if (Model.Message != null)
{
    <div class="banner @(Model.MessageIsError ? "error" : "info")">@Model.Message</div>
}

<section class="panel">
    <h3>Agent-Freigabe (automatisch)</h3>
    <p class="muted">Der Server legt beim Start eine <b>öffentlich lesbare Freigabe</b> an und hält dort immer die aktuelle
        Agent-MSI bereit (fester Name, wird überschrieben – auch nach jedem Server-Update). Du musst pro Domäne nur noch
        <b>eine GPO</b> mit genau diesem Pfad anlegen:</p>
    <p><code class="wrap" id="shareUnc">@Model.ShareUnc</code>
        <button class="link" type="button" onclick="navigator.clipboard.writeText(document.getElementById('shareUnc').textContent)">Pfad kopieren</button></p>
    @if (Model.ShareError != null)
    {
        <div class="banner error">Die Freigabe konnte nicht automatisch angelegt werden: @Model.ShareError<br />
            Du kannst die Freigabe von Hand anlegen (Ordner <code>C:\ProgramData\DNWsus\Share</code>, Freigabename <code>DNWsus</code>, Jeder lesen) oder unten einen abweichenden Zielpfad angeben.</div>
    }
    else
    {
        <p class="muted">Leserecht hat jedes Domänenkonto inkl. der Computerkonten (nötig, weil die GPO-Installation als Computerkonto läuft).
            Voraussetzung: die Clients erreichen den Server per SMB (Port 445) – die Firewall-Freigabe nimmst du selbst vor.</p>
    }
</section>

<section class="panels">
    <div class="panel">
        <h3>Agent-MSI</h3>
        @if (Model.TemplateExists)
        {
            <p>Die MSI ist fest an diesen Server gebunden – sie enthält seine Adresse und den Fingerabdruck seines Zertifikats.</p>
            @if (Model.MsiError != null)
            {
                <div class="banner error">MSI konnte nicht erzeugt werden: @Model.MsiError</div>
            }
            else
            {
                <p><a class="button" href="/download/DnwSus-Agent.msi">DnwSus-Agent.msi herunterladen (v@(Model.AgentVersion))</a></p>
                <p class="muted">Für die GPO reicht der Freigabe-Pfad oben. Der Download hier ist nur für die manuelle Installation gedacht
                    (Browser warnen, weil die MSI noch nicht code-signiert ist).</p>
            }
            <table class="mini">
                <tr><td>Server-Adresse</td><td><code>@Model.Identity.Url</code></td></tr>
                <tr><td>Zertifikat (SHA-256)</td><td><code class="wrap">@Model.Identity.CertificateHash</code></td></tr>
                <tr><td>Gültig bis</td><td>@Model.Identity.Certificate.NotAfter.ToString("dd.MM.yyyy")</td></tr>
            </table>
        }
        else
        {
            <div class="banner error">Die Agent-Vorlage fehlt im Installationsordner. Bitte die Server-MSI erneut installieren.</div>
        }
    </div>

    <div class="panel">
        <h3>Stand</h3>
        <table class="mini">
            <tr><td>Agenten, die sich schon gemeldet haben</td><td>@Model.Reporting</td></tr>
            <tr><td>davon in den letzten 24 Stunden</td><td>@Model.ReportingToday</td></tr>
        </table>
        <p class="muted">Clients ohne Agent stehen in der Übersicht mit „kein Agent“.</p>
    </div>
</section>

<section class="panel">
    <h3>Serverumzug</h3>
    @if (Model.MoveToUrl.Length > 0)
    {
        <div class="banner info">Serverumzug <b>aktiv</b>. Agenten stellen bei ihrer nächsten Meldung um auf:<br />
            <code class="wrap">@Model.MoveToUrl</code><br />
            Zertifikat <code class="wrap">@Model.MoveToCertHash</code></div>
        <p class="muted">Jeder Agent übernimmt den neuen Server erst, wenn dieser erreichbar ist und sein Zertifikat zum Fingerabdruck passt.
            Offline-Clients ziehen beim nächsten Kontakt nach. Beende den Umzug erst, wenn alle Agenten auf dem neuen Server gemeldet sind.</p>
        <form method="post" asp-page-handler="MigrateCancel" class="inline">
            <button type="submit" class="button secondary">Serverumzug beenden</button>
        </form>
    }
    else
    {
        <p class="muted">Agenten auf einen <b>neuen</b> DNWsus-Server umziehen, ohne eine neue MSI zu verteilen: Der alte Server teilt
            den Agenten Adresse und Zertifikat des neuen Servers mit, die Agenten stellen sich selbst um. Adresse und Fingerabdruck
            stehen im Dashboard des <b>neuen</b> Servers (Seite „Agent“).</p>
        <form method="post" asp-page-handler="Migrate" class="dist-form">
            <label class="field">Adresse des neuen Servers
                <input type="text" name="newUrl" placeholder="https://neuerserver.domäne:13162/" autocomplete="off" />
            </label>
            <label class="field">Zertifikat des neuen Servers (SHA-256)
                <input type="text" name="newCertHash" placeholder="AB12…" autocomplete="off" />
            </label>
            <button type="submit" class="button">Serverumzug starten</button>
        </form>
    }
</section>

<details class="panel">
    <summary><b>Abweichender Zielpfad (optional)</b></summary>
    <p class="muted" style="margin-top:10px">Nur nötig, wenn die Agent-MSI nicht in die Server-eigene Freigabe, sondern an einen
        <b>anderen</b> Ort soll (z. B. einen zentralen Dateiserver). Leer lassen = Server-eigene Freigabe oben wird genutzt.
        Es genügt ein <b>Ordner</b>; den Dateinamen <code>DnwSus-Agent.msi</code> hängt der Server an.</p>
    <form method="post" asp-page-handler="Copy" class="dist-form">
        <label class="field">Zielordner oder vollständiger Pfad
            <input type="text" name="targetPath" value="@Model.TargetPath" placeholder="\\fileserver\Software$\DNWsus" autocomplete="off" />
        </label>
        <ul class="muted" style="margin:0 0 10px">
            <li><b>Eigene Freigabe:</b> Schreibrecht für das Computerkonto dieses Servers → Benutzer/Passwort leer lassen (läuft dann auch automatisch).</li>
            <li><b>NETLOGON/SYSVOL:</b> Benutzer und Passwort eines Kontos mit Schreibrecht – gilt <b>nur für diese Kopie</b>, wird nicht gespeichert, keine Automatik.</li>
        </ul>
        <div class="dist-cred">
            <label class="field">Benutzer (optional)
                <input type="text" name="user" placeholder="DOMÄNE\Admin" autocomplete="off" />
            </label>
            <label class="field">Passwort (optional, nicht gespeichert)
                <input type="password" name="password" autocomplete="new-password" />
            </label>
        </div>
        <button type="submit" class="button secondary">Jetzt kopieren / testen</button>
    </form>
</details>

<section class="panel">
    <h3>Verteilung per GPO</h3>
    <ol>
        <li>Im Dashboard den <b>Freigabe-Pfad oben</b> kopieren (der Server hält die MSI dort automatisch aktuell).</li>
        <li>Neue GPO anlegen und mit der OU der Clients verknüpfen (Zuweisung der Update-Gruppen über Zielgruppenadressierung).</li>
        <li><i>Computerkonfiguration → Richtlinien → Softwareeinstellungen → Softwareinstallation</i> → Neu → Paket → den Freigabe-Pfad eintragen → <b>Zugewiesen</b>.</li>
        <li>Die Installation läuft beim nächsten Neustart des Clients. Danach meldet sich der Agent innerhalb von 5 Minuten hier.</li>
        <li><b>Agent-Update:</b> nichts weiter nötig – der Server tauscht die MSI in der Freigabe bei jedem Update selbst aus; die GPO zeigt dauerhaft auf denselben Pfad.</li>
    </ol>
    <p class="muted">Manuelle Installation: MSI (Download oben) auf dem Client per Doppelklick ausführen (Administratorrechte nötig).
        Ein Agent ohne Update-Gruppe meldet nur seinen Stand und installiert nichts.</p>
    <p class="muted">Voraussetzung: Windows 10/11 (zum Testen auch Windows Server ab 2016) mit .NET Framework 4.6.2 oder neuer (dort ab Werk enthalten),
        Verbindung zu diesem Server auf Port @(new Uri(Model.Identity.Url).Port) (im Büro oder per VPN) und SMB (Port 445) zur Freigabe.</p>
</section>

<h3>Letzte Ereignisse</h3>
@if (Model.RecentEvents.Count == 0)
{
    <p class="muted">Noch keine Einträge.</p>
}
else
{
    <table class="grid">
        <tbody>
            @foreach (var e in Model.RecentEvents)
            {
                <tr>
                    <td>@e.Time.ToString("dd.MM.yyyy HH:mm")</td>
                    <td><a href="/Client?name=@e.Client">@e.Client</a></td>
                    <td class="wrap @(e.IsError ? "error" : "")">@e.Text</td>
                </tr>
            }
        </tbody>
    </table>
}
