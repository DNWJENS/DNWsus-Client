@page
@model IndexModel
@{
    ViewData["Title"] = "Clients";
    var s = Model.Snapshot;
    bool overview = Model.Tab == "uebersicht";
    bool ungrouped = Model.Tab == "ohne";
    bool settings = Model.Tab == "einstellungen";
    bool log = Model.Tab == "log";
    bool groupTab = Model.GroupNumber > 0;
    bool clientList = !settings && !log; // Client-Tabelle nur in Client-Ansichten
    string[] dayNames = { "So", "Mo", "Di", "Mi", "Do", "Fr", "Sa" };
    int[] dayOrder = { 1, 2, 3, 4, 5, 6, 0 };
}

<nav class="tabs">
    <a class="@(overview ? "active" : "")" href="?tab=uebersicht">Übersicht <span class="count">@s.Clients.Count</span></a>
    @foreach (var g in s.Groups)
    {
        <a class="@(Model.Tab == "grp" + g.Number ? "active" : "")" href="?tab=grp@(g.Number)">@g.Name <span class="count">@Model.CountInGroup(g.Number)</span></a>
    }
    <a class="@(ungrouped ? "active" : "") @(Model.Ungrouped > 0 ? "warn" : "")" href="?tab=ohne">Ohne Gruppe <span class="count">@Model.Ungrouped</span></a>
    <span class="spacer"></span>
    <a class="@(log ? "active" : "")" href="?tab=log">LOG</a>
    <a class="@(settings ? "active" : "")" href="?tab=einstellungen" title="Einstellungen">⚙ Einstellungen</a>
</nav>

@if (Model.Message != null)
{
    <div class="banner info">@Model.Message</div>
}
@if (s.Error != null)
{
    <div class="banner error">@s.Error</div>
}
@foreach (var g in s.Groups.Where(g => !g.Found && s.Error == null))
{
    <div class="banner warn">Die Gruppe <b>@g.Name</b> wurde im AD nicht gefunden.</div>
}
@if (Model.Conflicts > 0)
{
    <div class="banner error">@Model.Conflicts Client(s) sind in mehreren Update-Gruppen. Bitte im AD bereinigen – diese Clients werden nicht aktualisiert.</div>
}
@if (Model.Tab == "grp0")
{
    <div class="banner info">Reine <b>Beobachtung</b>: Diese Clients haben den Agenten und melden ihren Stand (ausstehende Updates, Neustart-Bedarf, IP, Uptime, Benutzer …), <b>installieren aber nichts</b>. Zum Aktivieren den Client im AD in eine aktive Gruppe (GRP_Update1–3) verschieben – das wirkt automatisch, ohne Neuinstallation.</div>
}
@if (Model.CurrentGroup is { HiddenMembers.Count: > 0 } cg)
{
    <div class="banner warn">
        @cg.HiddenMembers.Count Mitglied(er) von <b>@cg.Name</b> sind keine aktiven Clients und werden nicht aktualisiert:
        <ul class="names">
            @foreach (var h in cg.HiddenMembers)
            {
                <li><b>@h.Name</b> <span class="muted">– @h.Reason</span></li>
            }
        </ul>
    </div>
}
@{ var withoutAgent = Model.Rows.Where(r => r.Status?.LastContact == null).Select(r => r.Ad.Name).ToList(); }
@if (withoutAgent.Count > 0 && !ungrouped)
{
    <div class="banner warn">
        @withoutAgent.Count von @Model.Rows.Count Client(s) in dieser Ansicht haben sich noch nie mit einem Agenten gemeldet@(groupTab ? ":" : " – Filter „Nur ohne Agent“ zeigt sie.")
        @if (groupTab)
        {
            <span class="names-inline">@string.Join(", ", withoutAgent)</span>
        }
    </div>
}

@if (settings)
{
    var installOpts = new[] { ("immediate", "Sofort"), ("schedule", "Nach Zeitplan"), ("manual", "Manuell"), ("off", "Aus") };
    var rebootOpts = new[] { ("template", "Wie Gruppe (Vorlage)"), ("prompt", "Verschiebbar per Popup"), ("auto", "Automatisch nach Hinweis"), ("none", "Kein erzwungener Neustart") };

    <h2>Einstellungen</h2>
    <p class="muted">Dauerhafte Konfiguration pro Gruppe: Neustart-Vorlage, Regeln je Update-Klasse und Zeitpläne.
        Änderungen übernehmen die Agenten bei ihrer nächsten Meldung.</p>

    @foreach (var g in Model.ActiveGroups)
    {
        var gn = g.Number;
        var policies = Model.AllPolicies.TryGetValue(gn, out var pp) ? pp : new();
        var schedules = Model.AllSchedules.TryGetValue(gn, out var ss) ? ss : new();
        var template = Model.RebootTemplates.TryGetValue(gn, out var tt) ? tt : gn;

        <details class="panel" open>
            <summary><b>@g.Name</b> <span class="muted">– @Model.CountInGroup(gn) Client(s)</span></summary>

            <h3 style="margin-top:12px">Neustart-Vorlage</h3>
            <form method="post" asp-page-handler="RebootTemplate" class="schedule-form">
                <input type="hidden" name="group" value="@gn" />
                <select name="template">
                    @for (int t = 1; t <= 3; t++)
                    {
                        <option value="@t" selected="@(template == t)">@IndexModel.RebootTemplateLabel(t)</option>
                    }
                </select>
                <button class="button" type="submit">Speichern</button>
            </form>
            <p class="muted" style="font-size:12.5px">Gilt für Klassen auf „Wie Gruppe". Ist niemand angemeldet, wird direkt neu gestartet.</p>

            <h3 style="margin-top:16px">Regeln je Update-Klasse</h3>
            <form method="post" asp-page-handler="Policy">
                <input type="hidden" name="group" value="@gn" />
                <table class="grid matrix">
                    <thead><tr><th>Klasse</th><th>Installation</th><th>Neustart (falls nötig)</th></tr></thead>
                    <tbody>
                        @foreach (var cls in IndexModel.PolicyClasses)
                        {
                            var rule = policies.TryGetValue(cls, out var r) ? r : new UpdatePolicy.Rule("manual", "template");
                            <tr>
                                <td>@IndexModel.ClassLabel(cls)<input type="hidden" name="classes" value="@cls" /></td>
                                <td><select name="install">@foreach (var (v, l) in installOpts) { <option value="@v" selected="@(rule.Install == v)">@l</option> }</select></td>
                                <td><select name="reboot">@foreach (var (v, l) in rebootOpts) { <option value="@v" selected="@(rule.Reboot == v)">@l</option> }</select></td>
                            </tr>
                        }
                    </tbody>
                </table>
                <p style="margin-top:12px"><button class="button" type="submit">Regeln speichern</button></p>
            </form>

            <h3 style="margin-top:16px">Zeitpläne</h3>
            @if (schedules.Count == 0)
            {
                <p class="muted">Keine Zeitpläne – „Nach Zeitplan"-Klassen laufen erst, wenn ein Zeitplan angelegt ist.</p>
            }
            <ul class="plain">
                @foreach (var sch in schedules)
                {
                    <li>
                        <form method="post" asp-page-handler="DeleteSchedule" class="inline" onsubmit="return confirm('Zeitplan löschen?');">
                            <input type="hidden" name="group" value="@gn" />
                            <input type="hidden" name="id" value="@sch.Id" />
                            <b>@(string.IsNullOrEmpty(sch.Class) ? "Alle „Nach Zeitplan\"-Klassen" : IndexModel.ClassLabel(sch.Class))</b>:
                            @sch.Description <span class="muted">– nächster: @sch.NextAfter(DateTime.Now).ToString("dd.MM. HH:mm")</span>
                            <button class="link" type="submit">löschen</button>
                        </form>
                    </li>
                }
            </ul>
            <form method="post" asp-page-handler="AddSchedule" class="schedule-form">
                <input type="hidden" name="group" value="@gn" />
                <select name="cls" title="Welche Klasse soll dieser Zeitplan installieren?">
                    <option value="">Alle „Nach Zeitplan"-Klassen</option>
                    @foreach (var cls in IndexModel.PolicyClasses)
                    {
                        <option value="@cls">@IndexModel.ClassLabel(cls)</option>
                    }
                </select>
                <select name="kind" class="schedule-kind">
                    <option value="woechentlich">Wöchentlich</option>
                    <option value="patchday">Nach Patchday</option>
                </select>
                <span class="weekdays">
                    @foreach (var d in dayOrder)
                    {
                        <label class="check"><input type="checkbox" name="days" value="@d" />@dayNames[d]</label>
                    }
                </span>
                <span class="patchday-offset" hidden>+ <input type="number" name="offset" min="0" max="27" value="2" class="small" /> Tage</span>
                um <input type="time" name="time" value="12:00" required />
                <button class="button" type="submit">Hinzufügen</button>
            </form>
        </details>
    }
}

@if (log)
{
    <h2>LOG</h2>
    <section class="panel">
        <h3>Läufe</h3>
        @if (Model.AllRuns.Count == 0)
        {
            <p class="muted">Noch keine Läufe.</p>
        }
        else
        {
            <table class="grid">
                <thead><tr><th>#</th><th>Start</th><th>Gruppe</th><th>Ziel</th><th>Quelle</th><th>Klassen</th><th>Erledigt</th><th>Status</th></tr></thead>
                <tbody>
                    @foreach (var run in Model.AllRuns)
                    {
                        <tr class="@(run.Cancelled ? "muted" : "")">
                            <td>@run.Id</td>
                            <td data-sort="@run.StartAt.ToString("yyyyMMddHHmmss")">@run.StartAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>@(run.GroupNumber == 0 ? "–" : "Gruppe " + run.GroupNumber)</td>
                            <td>@(run.Client ?? "ganze Gruppe")</td>
                            <td title="@run.CreatedBy">@run.Source</td>
                            <td class="muted">@(string.IsNullOrEmpty(run.Classes) ? "alle" : run.Classes)</td>
                            <td>@run.DoneCount</td>
                            <td>
                                @if (run.Cancelled) { <span class="muted">beendet</span> }
                                else
                                {
                                    <form method="post" asp-page-handler="CancelRun" class="inline" onsubmit="return confirm('Lauf #@run.Id beenden?');">
                                        <input type="hidden" name="id" value="@run.Id" />
                                        <button class="link" type="submit">beenden</button>
                                    </form>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>

    <section class="panel">
        <h3>Ereignisse</h3>
        @if (Model.Events.Count == 0)
        {
            <p class="muted">Noch keine Einträge.</p>
        }
        else
        {
            <table class="grid">
                <tbody>
                    @foreach (var e in Model.Events)
                    {
                        <tr>
                            <td data-sort="@e.Time.ToString("yyyyMMddHHmmss")">@e.Time.ToString("dd.MM.yyyy HH:mm")</td>
                            <td><a href="/Client?name=@e.Client">@e.Client</a></td>
                            <td class="wrap @(e.IsError ? "error" : "")">@e.Text</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </section>
}

@if (clientList)
{
<form method="post" id="clientForm">
    <input type="hidden" name="tab" value="@Model.Tab" />
    <input type="hidden" name="group" value="@Model.GroupNumber" />

    <div class="toolbar">
        <input id="search" type="search" placeholder="Suchen (Name, Benutzer, IP, Betriebssystem …)" autocomplete="off" />
        <label class="check"><input id="hideStale" type="checkbox" /> Veraltete ausblenden</label>
        <label class="check"><input id="onlyNoAgent" type="checkbox" /> Nur ohne Agent</label>
        <span class="muted" id="visibleCount"></span>
        <span class="spacer"></span>
        <span class="muted">AD-Stand: @s.LoadedAt.ToString("HH:mm:ss")</span>
        <a class="button secondary" href="?tab=@Model.Tab&refresh=true">AD neu laden</a>
        <button type="button" class="button secondary bulk-btn" title="Soforthilfe für ausgewählte Clients (Updates/Neustart)" onclick="openBulk()">⋯</button>
    </div>

    <div class="toolbar actions">
        @if (groupTab)
        {
            <label>Updatestart <input type="datetime-local" name="startAt" title="leer = sofort" /></label>
            <button class="button" asp-page-handler="Install" name="whole" value="true"
                    onclick="return confirm('Updates auf allen Clients der Gruppe @Model.CurrentGroup?.Name installieren?');">Ganze Gruppe installieren</button>
            <button class="button" asp-page-handler="Install" name="whole" value="false"
                    onclick="return confirmSelected('Updates auf den ausgewählten Clients installieren?');">Ausgewählte installieren</button>
        }
        <button class="button secondary" asp-page-handler="Scan" onclick="return confirmSelected(null);">Ausgewählte neu scannen</button>
    </div>

    <table class="grid" id="clients">
        <thead>
            <tr>
                <th class="sel"><input type="checkbox" id="selectAll" title="Alle sichtbaren auswählen" /></th>
                <th>Name</th>
                @if (overview) { <th>Gruppe</th> }
                <th>Status</th>
                @if (groupTab) { <th>Lauf</th> }
                <th>Ausstehend</th>
                @if (!ungrouped)
                {
                    <th>Uptime</th>
                    <th>IP</th>
                }
                <th>Letzter Benutzer</th>
                <th>Letzter Serverkontakt</th>
                <th title="Agent-Version; älter als @IndexModel.MinCompatibleAgentVersion.ToString(3) = inkompatibel">Agent</th>
                @if (!ungrouped) { <th>Fehler</th> }
                <th>Betriebssystem</th>
                <th title="lastLogonTimestamp aus dem AD, wird nur etwa alle 14 Tage aktualisiert">AD-Anmeldung</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                var c = row.Ad;
                var st = row.Status;
                string groupLabel = Model.GroupLabel(c);
                <tr class="@(c.IsStale ? "stale" : "")" data-stale="@(c.IsStale ? "1" : "0")" data-noagent="@(st?.LastContact == null ? "1" : "0")"
                    data-reboot="@(IndexModel.RebootNeeded(st) ? "1" : "0")"
                    data-search="@($"{c.Name} {c.DnsName} {c.OperatingSystem} {groupLabel} {st?.UserText} {st?.IpAddresses}".ToLowerInvariant())">
                    <td class="sel"><input type="checkbox" name="selected" value="@c.Name" /></td>
                    <td title="@c.DistinguishedName"><a href="/Client?name=@c.Name"><b>@c.Name</b></a>@if (c.IsServer) { <span class="tag">Server</span> }</td>
                    @if (overview)
                    {
                        <td class="@(c.Groups.Count == 0 ? "warn" : c.Groups.Count > 1 ? "error" : "")">@(c.Groups.Count > 1 ? "Konflikt: " : "")@groupLabel</td>
                    }
                    <td class="@(st?.LastContact == null || st.RebootPendingSince != null ? "warn" : "")">@IndexModel.StateText(st)</td>
                    @if (groupTab)
                    {
                        <td data-sort="@(row.PendingRunStart?.ToString("yyyyMMddHHmmss") ?? "0")">@(row.PendingRunStart == null ? "—" : row.PendingRunStart > DateTime.Now ? "geplant " + row.PendingRunStart.Value.ToString("dd.MM. HH:mm") : "offen")</td>
                    }
                    <td data-sort="@(st?.LastScan == null ? -1 : st.PendingCount)" title="@(st?.LastScan == null ? "" : "Scan: " + IndexModel.FormatDate(st.LastScan))">@(st?.LastScan == null ? "—" : st.PendingCount.ToString())</td>
                    @if (!ungrouped)
                    {
                        <td data-sort="@(st?.BootTime == null ? -1 : (long)(DateTime.Now - st.BootTime.Value).TotalMinutes)">@(st?.UptimeText ?? "—")</td>
                        <td>@(string.IsNullOrEmpty(st?.IpAddresses) ? "—" : st.IpAddresses)</td>
                    }
                    <td>@(string.IsNullOrEmpty(st?.UserText) ? "—" : st.UserText)</td>
                    <td class="@(IndexModel.ContactIsOld(st) ? "warn" : "")" data-sort="@(st?.LastContact?.ToString("yyyyMMddHHmmss") ?? "0")" title="@IndexModel.FormatDate(st?.LastContact)">@(st?.LastContact == null ? "nie" : IndexModel.FormatAge(st.LastContact))</td>
                    <td class="@(Model.IsAgentIncompatible(st) ? "warn" : "")" data-sort="@(st?.AgentVersion ?? "")" title="@(Model.IsAgentIncompatible(st) ? "inkompatibel – mindestens " + IndexModel.MinCompatibleAgentVersion.ToString(3) + " nötig" : "")">@(string.IsNullOrEmpty(st?.AgentVersion) ? "—" : st.AgentVersion)@if (Model.IsAgentIncompatible(st)) { <span class="tag outdated">inkompatibel</span> }</td>
                    @if (!ungrouped)
                    {
                        <td class="error" title="@st?.LastError">@(string.IsNullOrEmpty(st?.LastError) ? "" : (st.LastError.Length > 40 ? st.LastError[..40] + "…" : st.LastError))</td>
                    }
                    <td>@c.OperatingSystem <span class="muted">@c.OsVersion</span></td>
                    <td data-sort="@(c.LastAdLogon?.ToString("yyyyMMddHHmmss") ?? "0")" title="@IndexModel.FormatDate(c.LastAdLogon)">@IndexModel.FormatAge(c.LastAdLogon)</td>
                </tr>
            }
        </tbody>
    </table>
</form>

@if (Model.Rows.Count == 0)
{
    <p class="muted empty">Keine Clients in dieser Ansicht.</p>
}

<div class="modal-overlay" id="bulkModal" hidden>
    <div class="modal">
        <div class="modal-header">
            <h3>Soforthilfe für ausgewählte Clients</h3>
            <button type="button" class="modal-close" onclick="closeBulk()" aria-label="Schließen">&times;</button>
        </div>
        <form method="post" asp-page-handler="Bulk" class="modal-body">
            <input type="hidden" name="tab" value="@Model.Tab" />
            <div id="bulkSelected"></div>
            <p id="bulkSummary" class="muted"></p>
            <p class="muted">Manueller Eingriff bei dringenden Themen, unabhängig von den Gruppen-Zeitplänen. Wirkt nur auf Clients mit Agent.</p>
            <label class="field">Updatestart
                <input type="datetime-local" name="startAt" />
                <span class="field-hint">leer = sofort</span>
            </label>
            <label class="field">Reboot-Zeit
                <input type="datetime-local" name="rebootAt" />
                <span class="field-hint">Ab diesem Zeitpunkt (falls ein Neustart nötig ist): angemeldete Benutzer bekommen die Verzögerungsoptionen ihrer Gruppe, ohne angemeldeten Benutzer wird neu gestartet. Leer = sobald nötig nach Gruppenverhalten.</span>
            </label>
            <div class="modal-footer">
                <button type="button" class="button secondary" onclick="closeBulk()">Abbrechen</button>
                <button type="submit" class="button">Soforthilfe starten</button>
            </div>
        </form>
    </div>
</div>
}

