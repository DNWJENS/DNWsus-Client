<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <RootNamespace>DnwSus.Hinweis</RootNamespace>
    <AssemblyName>DnwSus.Hinweis</AssemblyName>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>2.0.0</Version>
    <Product>DNWsus</Product>
    <Company>DNW</Company>
    <Description>DNWsus – Hinweis zum Neustart nach Windows-Updates</Description>
  </PropertyGroup>

  <ItemGroup>
    <!-- Markenlogo (transparent) und DNW-Hausschrift Ubuntu (frei weiterverteilbar, Ubuntu Font License) -->
    <EmbeddedResource Include="Resources\dnw-logo.png" LogicalName="DnwSus.Hinweis.dnw-logo.png" />
    <EmbeddedResource Include="Resources\Ubuntu-Regular.ttf" LogicalName="DnwSus.Hinweis.Ubuntu-Regular.ttf" />
    <EmbeddedResource Include="Resources\Ubuntu-Bold.ttf" LogicalName="DnwSus.Hinweis.Ubuntu-Bold.ttf" />
  </ItemGroup>

</Project>
